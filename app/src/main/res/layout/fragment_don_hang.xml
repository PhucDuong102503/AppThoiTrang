<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.DonHangFragment">

    <!-- ⭐ SỬA LỖI: Đặt ID cho RecyclerView khớp với file Java ⭐ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_don_hang_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="4dp"/>

    <!-- ⭐ SỬA LỖI: Đặt ID cho TextView khớp với file Java ⭐ -->
    <TextView
        android:id="@+id/txt_no_orders"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chưa có đơn hàng nào."
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="visible"/>
</FrameLayout>
